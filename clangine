#!/usr/bin/env bash
#
# clangine-de-poitrine — music while Claude Code is cooking
#
set -euo pipefail

CLANGINE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_FILE="/tmp/clangine-de-poitrine.state"
CONFIG_FILE="$CLANGINE_DIR/config.sh"
ENABLED_FILE="$CLANGINE_DIR/.enabled"  # presence = activated

# defaults
CLANGINE_PLAYLIST="spotify:album:3FqqIeynZXFBcyLS9FlWMo"  # Angine de Poitrine — Vol. II
CLANGINE_SHUFFLE="false"

# load user config if exists
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

# --- platform detection ---

case "$(uname -s)" in
  Darwin) CLANGINE_OS="macos" ;;
  Linux)  CLANGINE_OS="linux" ;;
  *)      CLANGINE_OS="unknown" ;;
esac

# --- helpers ---

_state() { cut -d: -f1 "$STATE_FILE" 2>/dev/null || echo "stopped"; }
_album() { cut -d: -f2- "$STATE_FILE" 2>/dev/null || echo ""; }
_is_enabled() { [[ -f "$ENABLED_FILE" ]]; }

# AppleScript bridge (macOS only)
_osa() {
  osascript -e "tell application \"Spotify\" to $1" 2>/dev/null
}

# Abort early with a helpful message if the platform can't be driven.
_ensure_player() {
  case "$CLANGINE_OS" in
    macos) ;;
    linux)
      if ! command -v playerctl &>/dev/null; then
        echo "clangine: playerctl is required on Linux." >&2
        echo "  Install it with: sudo apt install playerctl   (or: sudo pacman -S playerctl)" >&2
        exit 1
      fi
      ;;
    *)
      echo "clangine: unsupported platform ($(uname -s))" >&2
      exit 1
      ;;
  esac
}

# --- player abstraction (dispatches on OS) ---

_player_running() {
  case "$CLANGINE_OS" in
    macos) osascript -e 'tell application "System Events" to (name of processes) contains "Spotify"' 2>/dev/null | grep -q "true" ;;
    linux) pgrep -x spotify >/dev/null 2>&1 ;;
  esac
}

_player_launch() {
  case "$CLANGINE_OS" in
    macos) open -a Spotify ;;
    linux) (spotify >/dev/null 2>&1 &) ;;
  esac
}

_player_play() {
  case "$CLANGINE_OS" in
    macos) _osa "play" ;;
    linux) playerctl -p spotify play 2>/dev/null ;;
  esac
}

_player_pause() {
  case "$CLANGINE_OS" in
    macos) _osa "pause" ;;
    linux) playerctl -p spotify pause 2>/dev/null ;;
  esac
}

_player_next() {
  case "$CLANGINE_OS" in
    macos) _osa "next track" ;;
    linux) playerctl -p spotify next 2>/dev/null ;;
  esac
}

_player_play_uri() {
  case "$CLANGINE_OS" in
    macos) _osa "play track \"$1\"" ;;
    linux) playerctl -p spotify open "$1" 2>/dev/null ;;
  esac
}

_player_shuffle() {
  case "$CLANGINE_OS" in
    macos) _osa "set shuffling to $1" ;;
    linux) playerctl -p spotify shuffle "$([[ "$1" == "true" ]] && echo on || echo off)" 2>/dev/null ;;
  esac
}

# _player_meta <album|name|artist>
_player_meta() {
  case "$CLANGINE_OS" in
    macos) _osa "$1 of current track as string" ;;
    linux)
      local field
      case "$1" in
        album)  field="xesam:album" ;;
        name)   field="xesam:title" ;;
        artist) field="xesam:artist" ;;
      esac
      playerctl -p spotify metadata "$field" 2>/dev/null
      ;;
  esac
}

# --- commands ---

cmd_play() {
  _is_enabled || return 0
  _ensure_player
  if ! _player_running; then
    _player_launch
    sleep 2
  fi

  local state
  state="$(_state)"

  if [[ "$state" == "playing" ]]; then
    return 0
  fi

  if [[ "$state" == "paused" ]]; then
    # check if Spotify is still on our album
    local saved_album current_album
    saved_album="$(_album)"
    current_album=$(_player_meta album || echo "")
    if [[ -n "$saved_album" && "$current_album" == "$saved_album" ]]; then
      _player_play
      echo "playing:$saved_album" > "$STATE_FILE"
      return 0
    fi
    # different album — fall through to start ours
  fi

  # start our playlist from scratch
  if [[ -n "$CLANGINE_PLAYLIST" ]]; then
    _player_play_uri "$CLANGINE_PLAYLIST"
    if [[ "$CLANGINE_SHUFFLE" == "true" ]]; then
      _player_shuffle true
    fi
    # OpenUri is async over D-Bus; let Spotify switch tracks before we read metadata
    [[ "$CLANGINE_OS" == "linux" ]] && sleep 1
  else
    _player_play
  fi
  local album
  album=$(_player_meta album || echo "")
  echo "playing:$album" > "$STATE_FILE"
}

cmd_pause() {
  _is_enabled || return 0
  _ensure_player
  if [[ "$(_state)" == "playing" ]]; then
    _player_pause
    echo "paused:$(_album)" > "$STATE_FILE"
  fi
}

cmd_stop() {
  _ensure_player
  _player_pause
  echo "stopped:" > "$STATE_FILE"
}

cmd_skip() {
  _ensure_player
  _player_next
}

cmd_on() {
  touch "$ENABLED_FILE"
  echo "clangine activated — music will play while Claude Code works"
  cmd_play
}

cmd_off() {
  rm -f "$ENABLED_FILE"
  if _player_running 2>/dev/null; then
    _player_pause 2>/dev/null || true
  fi
  echo "stopped:" > "$STATE_FILE"
  echo "clangine deactivated — Spotify will be left alone"
}

cmd_toggle() {
  if _is_enabled; then
    cmd_off
  else
    cmd_on
  fi
}

cmd_status() {
  _ensure_player
  local state album
  state="$(_state)"
  album="$(_album)"
  echo "active:   $(_is_enabled && echo yes || echo no)"
  echo "state:    $state"
  [[ -n "$album" ]] && echo "album:    $album"
  if _player_running; then
    local track artist
    track=$(_player_meta name 2>/dev/null || echo "unknown")
    artist=$(_player_meta artist 2>/dev/null || echo "unknown")
    echo "track:    $track"
    echo "artist:   $artist"
    if [[ -n "$CLANGINE_PLAYLIST" ]]; then
      echo "playlist: $CLANGINE_PLAYLIST"
    fi
  else
    echo "spotify:  not running"
  fi
}

cmd_install() {
  local settings_file="$HOME/.claude/settings.json"
  local jukebox_path="$CLANGINE_DIR/clangine"

  mkdir -p "$HOME/.claude"

  local settings
  if [[ -f "$settings_file" ]]; then
    settings="$(cat "$settings_file")"
  else
    settings="{}"
  fi

  if ! command -v jq &>/dev/null; then
    echo "jq is required for install. Install it with: brew install jq"
    echo ""
    echo "Or manually add these hooks to $settings_file:"
    _print_hooks_json "$jukebox_path"
    return 1
  fi

  settings=$(echo "$settings" | jq --arg jp "$jukebox_path" '
    .hooks.UserPromptSubmit = [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ($jp + " play")
          }
        ]
      }
    ] |
    .hooks.Stop = [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ($jp + " pause")
          }
        ]
      }
    ] |
    .hooks.Notification = [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ($jp + " pause")
          }
        ]
      }
    ] |
    .hooks.PermissionRequest = [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ($jp + " pause")
          }
        ]
      }
    ] |
    .hooks.PostToolUse = [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ($jp + " play")
          }
        ]
      }
    ]
  ')

  echo "$settings" | jq '.' > "$settings_file"
  echo "Hooks installed in $settings_file"
  echo ""
  echo "Events wired:"
  echo "  UserPromptSubmit   → clangine play"
  echo "  PostToolUse        → clangine play"
  echo "  Stop               → clangine pause"
  echo "  Notification       → clangine pause"
  echo "  PermissionRequest  → clangine pause"
}

cmd_uninstall() {
  local settings_file="$HOME/.claude/settings.json"

  if [[ ! -f "$settings_file" ]]; then
    echo "No settings file found at $settings_file"
    return 0
  fi

  if ! command -v jq &>/dev/null; then
    echo "jq required. Manually remove the hooks from $settings_file"
    return 1
  fi

  local settings
  settings=$(cat "$settings_file" | jq '
    del(.hooks.UserPromptSubmit) |
    del(.hooks.Stop) |
    del(.hooks.Notification) |
    del(.hooks.PermissionRequest) |
    del(.hooks.PostToolUse) |
    if .hooks == {} then del(.hooks) else . end
  ')

  echo "$settings" | jq '.' > "$settings_file"
  echo "Hooks removed from $settings_file"
  cmd_stop 2>/dev/null || true
}

_print_hooks_json() {
  local jp="$1"
  cat <<EOF
{
  "hooks": {
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "$jp play" }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "$jp pause" }] }
    ],
    "Notification": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "$jp pause" }] }
    ],
    "PermissionRequest": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "$jp pause" }] }
    ],
    "PostToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "$jp play" }] }
    ]
  }
}
EOF
}

# --- main ---

cmd="${1:-help}"

case "$cmd" in
  play)      cmd_play ;;
  pause)     cmd_pause ;;
  stop)      cmd_stop ;;
  skip)      cmd_skip ;;
  on)        cmd_on ;;
  off)       cmd_off ;;
  toggle)    cmd_toggle ;;
  status)    cmd_status ;;
  install)   cmd_install ;;
  uninstall) cmd_uninstall ;;
  help|--help|-h)
    echo "clangine-de-poitrine — music while Claude Code is cooking"
    echo ""
    echo "Usage: clangine <command>"
    echo ""
    echo "Commands:"
    echo "  on         Activate (music plays while Claude Code works)"
    echo "  off        Deactivate (Spotify is left alone)"
    echo "  toggle     Toggle activation"
    echo "  play       Start/resume playback"
    echo "  pause      Pause playback"
    echo "  stop       Stop and reset"
    echo "  skip       Next track"
    echo "  status     Show current state"
    echo "  install    Add hooks to Claude Code settings"
    echo "  uninstall  Remove hooks from settings"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'clangine help' for usage" >&2
    exit 1
    ;;
esac
